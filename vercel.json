{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ],
  "rewrites": [
    {
      "source": "/t/:id",
      "destination": "/index.html"
    },
    {
      "source": "/t/:id/manage",
      "destination": "/index.html"
    },
    {
      "source": "/new",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}