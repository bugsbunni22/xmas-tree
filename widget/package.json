{
  "name": "bongo-tree-widget",
  "productName": "TreeWidget",
  "version": "1.1.0",
  "description": "모니터 구석에 떠 있는 크리스마스 트리 위젯",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "xvfb-run -a electron --no-sandbox test/e2e.js",
    "dist": "bash build/make-installer.sh"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.0.0",
    "resedit": "^2.0.0",
    "pe-library": "^1.0.0"
  },
  "build": {
    "appId": "bongo.tree.widget",
    "productName": "TreeWidget",
    "artifactName": "TreeWidget-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-preload.js",
      "setup.html",
      "icon.png",
      "tray.png",
      "package.json"
    ],
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "author": "bugsbunni22"
}